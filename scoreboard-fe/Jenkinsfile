pipeline {
  agent any

  stages {
    stage('Checkout Code') {
      steps {git branch: 'main', credentialsId: 'github-login', url: 'https://github.com/azeroth97/scoreboard-fe.git'}
    }

    stage('Build Image') {
      steps {sh 'docker build -t thongth04/scoreboard_fe:latest .'}
    }

    stage('Docker Login') {
      steps {
        withCredentials(
          [usernamePassword(credentialsId:'docker-login', usernameVariable:'DOCKER_USER', passwordVariable:'DOCKER_PASS')]
        ){
          sh 'docker login -u ${DOCKER_USER} -p ${DOCKER_PASS}'
        }
      }
    }

    stage('Push Image To Hub') {
      steps {sh 'docker push thongth04/scoreboard_fe:latest'}
    }

    stage('Deploy') {
      steps {
        withCredentials([
            sshUserPrivateKey(credentialsId:'ssh-login', keyFileVariable:'SSH_KEY',usernameVariable:'SSH_USER'),
            usernamePassword(credentialsId:'docker-login', usernameVariable:'DOCKER_USER', passwordVariable:'DOCKER_PASS'),
            string(credentialsId:'ip-server-fe', variable:'IP_SERVER_FE')
        ]) {
          sh '''
            ssh -o StrictHostKeyChecking=no -i ${SSH_KEY} ${SSH_USER}@${IP_SERVER_FE} "
              docker login -u ${DOCKER_USER} -p ${DOCKER_PASS}
              docker pull thongth04/scoreboard_fe:latest
              docker stop scoreboard_fe && docker rm scoreboard_fe
              docker run --name scoreboard_fe -d -p 3000:80 thongth04/scoreboard_fe:latest
              docker image prune -f
            "
          '''
        }
      }
    }
  }
}